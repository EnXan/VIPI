# Optional API keys. Fill in only the OCR/detection providers you use.
TYPESAFE_API_KEY=your-typesafe-api-key
OPENAI_API_KEY=your-openai-api-key
# OPENAI_API_KEY is shared by the OpenAI detector and GPT-6 Luna cloud OCR.

# Jev also accepts JEV_API_KEY as an alias for TYPESAFE_API_KEY.
# Set only one of these two names.
# JEV_API_KEY=

# Optional: Hugging Face access for downloading restricted Prompt Guard weights.
HF_TOKEN=your-huggingface-token

# Optional: --modus cloud defaults to Google Cloud Vision OCR.
# GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key
# GOOGLE_API_KEY is also accepted as an alias.

# Optional: --modus cloud --ocr-provider mistral.
# MISTRAL_API_KEY=your-mistral-api-key
