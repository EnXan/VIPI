# Optional API keys for external detectors. Fill in only the providers you use.
TYPESAFE_API_KEY=your-typesafe-api-key
OPENAI_API_KEY=your-openai-api-key

# Jev also accepts JEV_API_KEY as an alias for TYPESAFE_API_KEY.
# Set only one of these two names.
# JEV_API_KEY=

# Optional: Hugging Face access for downloading restricted Prompt Guard weights.
HF_TOKEN=your-huggingface-token

# Optional: use hosted Mistral OCR instead of local PP-OCRv6 for image scans.
# MISTRAL_API_KEY=your-mistral-api-key
